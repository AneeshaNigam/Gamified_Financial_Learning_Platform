# =============================================================================
#  MONEYMASTER — ENVIRONMENT CONFIGURATION
# =============================================================================
#  Copy this file to `.env` in the project root and fill in the values.
#  Variables marked [REQUIRED] must be set for the application to start.
#  Variables marked [OPTIONAL] enable additional features when provided.
#
#  Documentation: https://github.com/AneeshaNigam/Gamified_Financial_Learning_Platform
#  Live Platform:  https://finlearnplat.vercel.app
# =============================================================================


# ==============================
# APPLICATION CONFIGURATION
# ==============================

# Runtime environment — controls logging verbosity, CORS strictness, and error detail.
# Values: development | production | test
NODE_ENV=development

# Port the Express server listens on.
# Default: 5000
PORT=5000


# ==============================
# FRONTEND CONFIGURATION
# ==============================

# URL of the deployed client application (used for CORS origin whitelisting).
# In production, set this to your Vercel deployment URL.
# [REQUIRED in production]
CLIENT_URL=http://localhost:5173

# Backend API URL consumed by the React client.
# Prefix with VITE_ so Vite exposes it to the browser bundle.
# [REQUIRED]
VITE_API_URL=http://localhost:5000/api


# ==============================
# DATABASE CONFIGURATION
# ==============================

# MongoDB connection string (Atlas recommended for production).
# Supports both Atlas cluster URIs and local MongoDB instances.
# [REQUIRED]
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/<dbname>
MONGODB_URI=


# ==============================
# AUTHENTICATION — JWT
# ==============================

# Secret key used to sign and verify JSON Web Tokens.
# Generate a strong 256-bit key: `openssl rand -hex 64`
# [REQUIRED]
JWT_SECRET=

# Token expiration duration.
# Supports shorthand: 7d, 24h, 60m, etc.
# Default: 7d
JWT_EXPIRES_IN=7d


# ==============================
# AUTHENTICATION — GOOGLE OAUTH 2.0
# ==============================

# Google OAuth credentials for "Sign in with Google" functionality.
# Obtain from: https://console.cloud.google.com/apis/credentials
# [OPTIONAL] — Google sign-in is disabled if these are not set.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth callback URL — must match the redirect URI registered in Google Console.
# Default: http://localhost:5000/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback


# ==============================
# REDIS / CACHE CONFIGURATION
# ==============================

# Redis connection URL for matchmaking queue, Socket.io adapter, and anti-cheat.
# [OPTIONAL in development] — battle system features require Redis.
# [REQUIRED in production]
# Default: redis://localhost:6379
#
# Recommended providers: Redis Cloud, Render Redis, Upstash
REDIS_URL=redis://localhost:6379


# ==============================
# EMAIL SERVICE — BREVO (SENDINBLUE)
# ==============================

# Brevo HTTP API key for transactional emails (OTP verification, password reset).
# Uses HTTP API instead of SMTP — Render blocks outbound SMTP ports.
# Obtain from: https://app.brevo.com/settings/keys/api
# [OPTIONAL] — OTP codes are logged to console when not configured.
BREVO_API_KEY=


# ==============================
# AI / LLM CONFIGURATION
# ==============================

# OpenAI API key for GPT-4o-mini question generation.
# Enables automatic question pool replenishment when topic/difficulty
# drops below the configured threshold (default: 20 questions).
# Obtain from: https://platform.openai.com/api-keys
# [OPTIONAL] — platform functions normally without AI generation.
OPENAI_API_KEY=

# ElevenLabs API key for text-to-speech features.
# [OPTIONAL] — TTS features are disabled when not configured.
ELEVENLABS_API_KEY=


# ==============================
# DEPLOYMENT CONFIGURATION
# ==============================

# Frontend:  Vercel (auto-deploys from GitHub)
# Backend:   Render (Node.js service)
# Database:  MongoDB Atlas (free M0 tier available)
# Cache:     Redis Cloud / Render Redis add-on
#
# Production environment variables should be configured in
# the respective platform dashboards (Vercel / Render).
#
# Vercel Build Command:    npm run build
# Render Build Command:    cd server && npm install && npm run build
# Render Start Command:    cd server && npm run start


# ==============================
# FEATURE FLAGS
# ==============================

# Enable/disable optional platform capabilities.
# These are not currently wired into the codebase but reserved
# for future extensibility.

# ENABLE_BATTLE_SYSTEM=true
# ENABLE_AI_QUESTION_GENERATION=true
# ENABLE_GOOGLE_OAUTH=true
# ENABLE_EMAIL_NOTIFICATIONS=true
# ENABLE_STOCK_TRADING=true
